# map-service-hub — .env 템플릿
# 실제 값은 `.env`에 채우고 절대 commit 하지 않는다.
# 단일 docker-compose 운영 시 ../map-service-infra/.env.example과 동기화 유지.
# 변수명은 Settings 필드와 정확히 일치해야 .env 값이 로드된다
# (model_config: env_prefix 없음, extra="ignore" → 불일치 변수는 조용히 무시됨).

# ── (1) PostgreSQL (schema=hub_data) ───────────────────────────────
# HUB_DATABASE_URL 은 필수. SQLAlchemy 비동기 DSN 을 그대로 받는다.
# Alembic env.py 가 동기 드라이버로 치환해 마이그레이션에 재사용한다.
HUB_DATABASE_URL=postgresql+psycopg_async://map:replace-me@postgres:5432/map

# ── (2) 기상청(KMA) 예보 API ───────────────────────────────────────
# KMA_SERVICE_KEY 는 필수. data.go.kr 인증키(디코딩 키 권장 — 이중 인코딩 회피).
# 예보 폴링과 현재 날씨(초단기실황) 조회가 같은 키를 쓴다.
KMA_SERVICE_KEY=replace-me

# 대기오염정보(미세먼지) 서비스 키. 비워 두면 KMA_SERVICE_KEY 를 그대로 쓴다 —
# 한 계정 키로 두 서비스가 함께 열려 있으면 여기를 채울 필요가 없다. 키가
# 대기오염에 신청돼 있지 않으면 조회가 실패하고 미세먼지만 응답에서 빠진다.
# AIRKOREA_SERVICE_KEY=
# AIRKOREA_REQUEST_TIMEOUT_SEC=5.0
# AIRKOREA_CACHE_TTL_SEC=900
# WEATHER_NOW_CACHE_TTL_SEC=300
# 실황 스냅샷 보관 일수(어제 기온 비교의 근거). 하우스키핑이 이 기간을 넘긴
# row 를 지운다.
# WEATHER_SNAPSHOT_RETENTION_DAYS=3

# KMA 폴링 튜닝(모두 기본값 있음 — 필요할 때만 주석 해제).
# KMA_POLL_INTERVAL_SEC=1.5
# KMA_RETRY_INTERVAL_SEC=30
# KMA_RETRY_MAX_DURATION_SEC=1200
# KMA_REQUEST_TIMEOUT_SEC=10.0
# KMA_NUMOFROWS=1200
# KMA_RATE_LIMIT_SLEEP_SEC=2.0

# ── (3) 내부 서비스 인증 (B7 boundary) ─────────────────────────────
# /internal/* 호출 시 헤더 X-Internal-Token 과 일치 여부를 검사하는 공유 비밀.
# AUTH_ENFORCED=true 로 공개 endpoint 도 보호할 경우 반드시 값이 있어야 한다.
INTERNAL_SERVICE_TOKEN=replace-with-32-chars-or-more
# /internal/* 를 허용할 CIDR 목록(콤마 구분). 기본은 사설 IP 대역.
HUB_INTERNAL_TRUSTED_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# true 면 /v1/* 공개 endpoint 도 X-Internal-Token 을 요구한다.
# 기본 false = 현행 데모 동작(공개 endpoint 무인증). /health 는 항상 무인증.
AUTH_ENFORCED=false

# ── (4) 장소 소스 - 카카오 로컬 / 두루누비 코스 ────────────────────
# 키가 비어 있으면 실제 호출 대신 고정 스텁 응답으로 동작한다(키 발급 전 검증용).
KAKAO_REST_API_KEY=replace-me
# 두루누비(data.go.kr) 인증키(디코딩 키 권장 — 이중 인코딩 회피).
TOUR_API_SERVICE_KEY=replace-me
# 키가 채워져 있어도 강제로 스텁만 쓰고 싶으면 true.
PLACES_STUB_MODE=false

# ── (5) 장소 보강 - 네이버 블로그 리뷰 ─────────────────────────────
# 두 자격증명 중 하나라도 비어 있으면 /v1/reviews 는 스텁으로 동작한다.
# 시크릿은 요청 헤더(X-Naver-Client-Id / X-Naver-Client-Secret)로만 전달된다.
NAVER_CLIENT_ID=replace-me
NAVER_CLIENT_SECRET=replace-me
# 단일 요청 타임아웃(초)과 리뷰 결과 L1 캐시 TTL(초, 기본 6h).
NAVER_BLOG_TIMEOUT_SEC=3.0
NAVER_BLOG_CACHE_TTL_SEC=21600

# ── (5b) 장소 보강 - Google 장소 사진 ──────────────────────────────
# 키가 비어 있으면 /v1/places/photos 는 스텁으로 동작한다.
# 키는 요청 헤더(X-Goog-Api-Key)로만 전달되며 URL 에는 실리지 않는다.
GOOGLE_MAPS_API_KEY=replace-me
# 아래는 조정용 기본값이라 비워 두어도 된다.
# 단일 요청 타임아웃(초)과 좌표 주변 검색 반경(m).
GOOGLE_PLACES_TIMEOUT_SEC=3.0
GOOGLE_PLACES_BIAS_RADIUS_M=500
# 사진 조회 한 건 전체 제한 시간(초). 조회가 세 단계라 단계별 타임아웃의
# 합이 호출 측 대기 시간을 넘길 수 있어, 그보다 짧게 잡아 hub 가 직접
# 빈 목록으로 답하게 한다.
GOOGLE_PHOTOS_TOTAL_BUDGET_SEC=4.0
# 장소 식별자 캐시 TTL(초, 기본 30일)과 무매칭 기억 TTL(초, 기본 1일).
# 사진 이름과 이미지 URL 은 만료되는 값이라 캐시하지 않는다.
GOOGLE_PLACEID_CACHE_TTL_SEC=2592000
GOOGLE_PLACEID_NEG_CACHE_TTL_SEC=86400
# 장소당 사진 수와 요청 이미지 폭(px).
GOOGLE_PHOTOS_MAX_COUNT=3
GOOGLE_PHOTOS_MAX_WIDTH_PX=800
# 하루에 발급할 수 있는 이미지 URL 총량. 이 단계만 과금되며, 32×31 이면
# 월 1,000장 무료 한도 안에 머문다. 0 으로 두면 사진 조회를 끈다.
GOOGLE_PHOTOS_DAILY_MEDIA_CAP=32

# ── (5c) 지하철 경로 - ODsay ───────────────────────────────────────
# 키가 비어 있으면 /v1/transit/subway 는 스텁으로 동작한다.
# 키가 URL 쿼리에 실려 나가므로 오류 본문을 로그에 올릴 때 가린다.
# 발급처는 앱 등록마다 URI·서버·Android·iOS 로 키를 나눠 주지만 요청에는
# 어느 쪽인지 실리지 않아, 어떤 키를 넣어도 서버에서 호출된다.
ODSAY_API_KEY=replace-me
# 예비 키. 비워 두면 폴백 없이 동작한다. 발급처가 등록해 둔 쓰임과 요청이
# 맞지 않으면 키 인증 자체를 거절하므로, 한쪽이 막혔을 때 다른 키로 한 번 더
# 시도한다. 키에 얽힌 실패에만 다시 부르며 그 호출도 하루 상한을 함께 쓴다.
ODSAY_API_KEY_FALLBACK=
# 아래는 조정용 기본값이라 비워 두어도 된다.
# 단일 요청 타임아웃(초)과 조회 한 건 전체 제한 시간(초).
ODSAY_REQUEST_TIMEOUT_SEC=3.0
ODSAY_TOTAL_BUDGET_SEC=4.0
# 성공·경로없음 결과 TTL(초, 기본 6h)과 실패 기억 TTL(초).
ODSAY_CACHE_TTL_SEC=21600
ODSAY_FAIL_CACHE_TTL_SEC=60
# 하루 외부 호출 총량. 무료 등급 한도보다 낮게 잡는다. 0 이면 조회를 끈다.
ODSAY_DAILY_CALL_CAP=900
# 캐시 키를 만들 때 좌표를 반올림할 소수 자릿수.
ODSAY_CACHE_COORD_DIGITS=4

# ── (5d) 따릉이 대여소 - 서울 열린데이터광장 ───────────────────────
# 키가 비어 있으면 /v1/mobility/bike-stations 는 스텁으로 동작한다.
# 발급처가 https 를 받지 않아 이 호출만 평문으로 나간다. 키가 URL 경로에
# 실리는 형태라 오류 본문을 로그에 올릴 때 가린다.
SEOUL_OPENAPI_KEY=replace-me
# 아래는 조정용 기본값이라 비워 두어도 된다.
SEOUL_BIKE_REQUEST_TIMEOUT_SEC=3.0
SEOUL_BIKE_TOTAL_BUDGET_SEC=4.0
# 전량 스냅샷 TTL(초)과 일부만 받아 온 스냅샷 TTL(초). 앞의 값이 짧아질수록
# 하루 외부 호출 수가 그대로 비례해 늘어난다.
SEOUL_BIKE_CACHE_TTL_SEC=300
SEOUL_BIKE_PARTIAL_CACHE_TTL_SEC=30
# 한 번에 받아 오는 행 수와 최대 페이지 수, 잘라 보낼 기본 반경(m).
SEOUL_BIKE_PAGE_SIZE=1000
SEOUL_BIKE_MAX_PAGES=5
SEOUL_BIKE_DEFAULT_RADIUS_M=5000

# ── (5e) 공유 킥보드 - 국토교통부 퍼스널모빌리티 ───────────────────
# 비어 있으면 KMA_SERVICE_KEY 를 대신 쓴다(같은 발급처의 한 계정 키로 여러
# 서비스가 열려 있는 경우가 흔하다). 둘 다 비면 /v1/mobility/pm-vehicles 는
# 스텁으로 동작한다. 키가 URL 쿼리에 실려 나가므로 로그에서 가린다.
PM_SERVICE_KEY=
# 발급처가 사업자명을 필수로 받고 목록을 주는 오퍼레이션이 없어 여기에 적어
# 둔다. 한 번 조회에 사업자 수만큼 호출이 나가므로 캐시가 중요하다.
PM_PROVIDERS=Beam,GCOO,SWING,씽씽,킥고잉,Lime,지쿠,알파카
# 아래는 조정용 기본값이라 비워 두어도 된다.
PM_REQUEST_TIMEOUT_SEC=5.0
PM_TOTAL_BUDGET_SEC=4.0
# 위치가 계속 움직이는 값이라 짧게 잡는다. 일부 사업자만 실패한 결과는
# 더 짧게 담아 다음 요청에서 다시 채운다.
PM_CACHE_TTL_SEC=120
PM_FAIL_CACHE_TTL_SEC=30
PM_NUMOFROWS=100
PM_DEFAULT_RADIUS_M=1000

# ── (6) Redis (장소/리뷰 L1 캐시) ──────────────────────────────────
# Redis 에 비밀번호가 있으면 redis://:password@host:6379 형태로 적는다.
REDIS_URL=redis://redis:6379
# 캐시 전용 논리 DB 번호.
REDIS_DB_CACHE=4
